{
  "name": "ask-grok-bots",
  "version": "0.3.0",
  "description": "MCP server that lets AI assistants ask your Grok Bots for their opinions (Cloudflare Workers)",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "dev": "wrangler dev",
    "test:e2e": "node test/e2e.mjs",
    "db:migrate": "wrangler d1 migrations apply ask-grok-bots --remote",
    "deploy": "npm test && npm run typecheck && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "@types/node": "^22.20.5",
    "typescript": "~5.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.0"
  }
}
